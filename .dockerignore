# Remove files from the production Docker images that could contain sensitive information.
# This file does not affect the development builds, because the contexts for those are the
# api and frontend directories, respectively.

.cache/
.git/
.github/
/frontend/data
/frontend/dist
/frontend/.env.*
/frontend/public/environment.*
/frontend-vue3/data
/frontend-vue3/dist
/frontend-vue3/.env.*
/frontend-vue3/public/environment.*
**/vendor/
**/node_modules/
