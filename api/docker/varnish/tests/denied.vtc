varnishtest "A cached response is not served to a user who is denied access to its security delegate"

server s1 {
    rxreq
    expect req.url == "/camps/1/activities"
    txresp -hdr "X-Cache-Security-Delegate: /api/camps/1" -hdr "Cache-Control: public, s-maxage=60" -body "activities"

    # preflight of the stranger is denied
    rxreq
    expect req.url == "/authorization/check_access?iri=/api/camps/1"
    txresp -status 403 -hdr "Cache-Control: no-store, private"

    # the request is passed to the API, which answers as usual
    rxreq
    expect req.url == "/camps/1/activities"
    expect req.http.Cookie ~ "jwt_s=sigX"
    txresp -status 404 -body "not found"

    # a denied preflight is not cached, the decision is made again
    rxreq
    expect req.url == "/authorization/check_access?iri=/api/camps/1"
    txresp -status 403 -hdr "Cache-Control: no-store, private"

    rxreq
    expect req.url == "/camps/1/activities"
    txresp -status 404 -body "not found"
} -start

varnish v1 -vcl+backend {
    include "${vcldir}/default.vcl";
} -start

client c1 {
    txreq -url "/camps/1/activities" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    expect resp.status == 200

    txreq -url "/camps/1/activities" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpX; localhost_jwt_s=sigX"
    rxresp
    expect resp.status == 404
    expect resp.body == "not found"

    txreq -url "/camps/1/activities" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpX; localhost_jwt_s=sigX"
    rxresp
    expect resp.status == 404
} -run

server s1 -wait
