varnishtest "A response is shared between users who are granted access to its scope"

server s1 {
    # user A: cache miss, authorized by the API itself
    rxreq
    expect req.url == "/camps/1/activities"
    expect req.http.Cookie ~ "jwt_s=sigA"
    txresp -hdr "X-Cache-Scope: /api/camps/1" -hdr "Cache-Control: public, s-maxage=60" -body "activities"

    # user B: preflight, as the response is cached
    rxreq
    expect req.url == "/_cache_access"
    expect req.http.X-Cache-Scope == "/api/camps/1"
    expect req.http.Cookie ~ "jwt_s=sigB"
    txresp -hdr "X-Cache-Access: granted" -hdr "Cache-Control: public, s-maxage=60"
} -start

varnish v1 -vcl+backend {
    include "${vcldir}/default.vcl";
} -start

client c1 {
    txreq -url "/camps/1/activities" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    expect resp.status == 200
    expect resp.body == "activities"
    expect resp.http.X-Cache-Scope == <undef>

    txreq -url "/camps/1/activities" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpB; localhost_jwt_s=sigB"
    rxresp
    expect resp.status == 200
    expect resp.body == "activities"
    expect resp.http.X-Cache-Scope == <undef>

    # the grant of user B is cached: no more requests to the backend
    txreq -url "/camps/1/activities" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpB; localhost_jwt_s=sigB"
    rxresp
    expect resp.status == 200
    expect resp.body == "activities"
} -run

server s1 -wait
