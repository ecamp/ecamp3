varnishtest "Only successful responses which state how they are cached are cached"

server s1 {
    # no cache mode
    rxreq
    expect req.url == "/camps/1/activities"
    txresp -hdr "X-Cache-Debug: 1" -hdr "Cache-Control: public, s-maxage=60" -body "no mode"
    rxreq
    expect req.url == "/camps/1/activities"
    txresp -hdr "X-Cache-Debug: 1" -hdr "Cache-Control: public, s-maxage=60" -body "no mode"

    # shared, but no security delegate
    rxreq
    expect req.url == "/camps/1/checklists"
    txresp -hdr "X-Cache-Debug: 1" -hdr "X-Cache-Mode: shared" -hdr "Cache-Control: public, s-maxage=60" -body "no delegate"
    rxreq
    expect req.url == "/camps/1/checklists"
    txresp -hdr "X-Cache-Debug: 1" -hdr "X-Cache-Mode: shared" -hdr "Cache-Control: public, s-maxage=60" -body "no delegate"

    # not found, although the security delegate is present
    rxreq
    expect req.url == "/camps/1/categories"
    txresp -status 404 -hdr "X-Cache-Debug: 1" -hdr "X-Cache-Mode: shared" -hdr "X-Cache-Security-Delegate: /api/camps/1" -hdr "Cache-Control: public, s-maxage=60"
    rxreq
    expect req.url == "/camps/1/categories"
    txresp -status 404 -hdr "X-Cache-Debug: 1" -hdr "X-Cache-Mode: shared" -hdr "X-Cache-Security-Delegate: /api/camps/1" -hdr "Cache-Control: public, s-maxage=60"
} -start

varnish v1 -vcl+backend {
    include "${vcldir}/default.vcl";
} -start

client c1 {
    # every request is passed to the backend, nothing is cached
    txreq -url "/camps/1/activities" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    expect resp.status == 200
    expect resp.http.X-Cache == "PASS"
    txreq -url "/camps/1/activities" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    expect resp.status == 200
    expect resp.http.X-Cache == "PASS"

    txreq -url "/camps/1/checklists" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    expect resp.status == 200
    expect resp.http.X-Cache == "PASS"
    txreq -url "/camps/1/checklists" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    expect resp.status == 200
    expect resp.http.X-Cache == "PASS"

    txreq -url "/camps/1/categories" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    expect resp.status == 404
    expect resp.http.X-Cache == "PASS"
    txreq -url "/camps/1/categories" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    expect resp.status == 404
    expect resp.http.X-Cache == "PASS"
} -run

server s1 -wait
