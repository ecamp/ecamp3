varnishtest "Only successful responses which state their scope are cached"

server s1 {
    # no scope
    rxreq
    expect req.url == "/camps/1/activities"
    txresp -hdr "Cache-Control: public, s-maxage=60" -body "no scope"
    rxreq
    expect req.url == "/camps/1/activities"
    txresp -hdr "Cache-Control: public, s-maxage=60" -body "no scope"

    # not found, although the scope is present
    rxreq
    expect req.url == "/camps/1/categories"
    txresp -status 404 -hdr "X-Cache-Scope: /api/camps/1" -hdr "Cache-Control: public, s-maxage=60"
    rxreq
    expect req.url == "/camps/1/categories"
    txresp -status 404 -hdr "X-Cache-Scope: /api/camps/1" -hdr "Cache-Control: public, s-maxage=60"
} -start

varnish v1 -vcl+backend {
    include "${vcldir}/default.vcl";
} -start

client c1 {
    txreq -url "/camps/1/activities" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    txreq -url "/camps/1/activities" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    expect resp.status == 200

    txreq -url "/camps/1/categories" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    txreq -url "/camps/1/categories" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    expect resp.status == 404
} -run

server s1 -wait
