varnishtest "A client requesting the access check through the cache always gets an answer of the API"

server s1 {
    rxreq
    expect req.url == "/authorization/check_access?iri=/api/camps/1"
    txresp -status 200 -hdr "Cache-Control: public, s-maxage=60"

    rxreq
    expect req.url == "/authorization/check_access?iri=/api/camps/1"
    expect req.http.Cookie ~ "jwt_s=sigX"
    txresp -status 403 -hdr "Cache-Control: no-store, private"
} -start

varnish v1 -vcl+backend {
    include "${vcldir}/default.vcl";
} -start

client c1 {
    txreq -url "/authorization/check_access?iri=/api/camps/1" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpA; localhost_jwt_s=sigA"
    rxresp
    expect resp.status == 200

    # the answer for another user is not taken from the cache
    txreq -url "/authorization/check_access?iri=/api/camps/1" -hdr "Accept: application/hal+json" -hdr "Cookie: localhost_jwt_hp=hpX; localhost_jwt_s=sigX"
    rxresp
    expect resp.status == 403
} -run

server s1 -wait
