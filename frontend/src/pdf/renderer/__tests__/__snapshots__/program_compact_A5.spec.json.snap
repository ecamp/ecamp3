                                {
                                  "box": {},
                                  "children": [
                                    {
                                      "box": {},
                                      "children": [
                                        {
                                          "box": {},
                                          "children": [],
                                          "parent": [Circular],
                                          "props": {},
                                          "style": {},
                                          "type": "TEXT",
                                        },
                                      ],
                                      "parent": [Circular],
                                      "props": {
                                        "class": "storyboard-cell storyboard-column-1 storyboard-cell-compact",
                                      },
                                      "style": {
                                        "flexGrow": "0",
                                        "flexShrink": "0",
                                        "fontFeatureSettings": {
                                          "tnum": 1,
                                        },
                                        "lineHeight": "0.8",
                                        "overflow": "hidden",
                                        "paddingBottom": "3pt",
                                        "paddingRight": "2pt",
                                        "paddingTop": "1pt",
                                        "width": "42pt",
                                      },
