                                    {
                                      "box": {},
                                      "children": [
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "Was giebt es besseres als zu Snacken beim Warten. Wir erklären den Kindern wie man Brennesselchips macht.",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "1. Die Brennnesseln am besten mit Handschuhen schneiden und die Blätter abpflücken",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "2. Blätter waschen und in Salatschleuder trocknen. Sobald die Brennnesseln gewaschen sind, brennen sie nicht mehr!",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "3. Kokosfett oder Rapsöl in der Pfanne heiss werden lassen, die Brennnesselblätter beifügen und mit der Kelle vorsichtig wenden",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "5. Wenn die Blätter knusprig sind, auf Küchenpapier abtropfen lassen",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
