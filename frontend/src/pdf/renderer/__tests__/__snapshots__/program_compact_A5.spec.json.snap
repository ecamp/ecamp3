                                    {
                                      "box": {},
                                      "children": [
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "Wir schreiben gemeinsam das  Pfadiversprechen und das Pfadigesetz auf (TN's sollen sagen was sie schon wissen, wir ergänzen): ",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "Versprechen:",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "Ich verspreche, mein möglichstes zu tun, um ",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "mich immer von neuem mit dem Pfadigesetz auseinanderzusetzen",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "nach Sinn und Ziel meines Lebens zu suchen",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "mich in jeder Gemeinschaft einzusetzen, in der ich lebe",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "(Im Vertrauen auf Gott und) Zusammen mit Euch allen versuche ich, nach diesem Versprechen zu leben. ",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "Gesetz:",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "Wir Pfadi wollen...",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "...offen und ehrlich sein",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "...Freude suchen und weitergeben",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "...unsere Hilfe anbieten",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "...uns entscheiden und Verantwortung tragen",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "...andere verstehen und achten",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "...miteinander teilen",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "...Sorge tragen zur Natur und allem Leben",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                        {
                                          "box": {},
                                          "children": [
                                            {
                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "...Schwierigkeiten mit Zuversicht begegnen",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
                                            "marginBottom": "2pt",
                                          },
                                          "type": "TEXT",
                                        },
                                      ],
