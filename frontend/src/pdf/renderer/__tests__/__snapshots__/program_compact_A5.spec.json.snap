                                              "parent": [Circular],
                                              "type": "TEXT_INSTANCE",
                                              "value": "Aus sechs Streichhölzern 4 gleich grosse Dreiecke machen",
                                            },
                                          ],
                                          "parent": [Circular],
                                          "props": {
                                            "class": "p",
                                          },
                                          "style": {
