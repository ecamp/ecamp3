{
  "name": "@ecamp3/translations",
  "private": true,
  "dependencies": {
    "deepl-node": "1.28.1"
  },
  "scripts": {
    "sort-frontend-de": "node deepl.js ../frontend/src/locales/de.json ../frontend/src/locales/de.json",
    "sort-frontend-de-ch-scout": "node deepl.js ../frontend/src/locales/de-CH-scout.json ../frontend/src/locales/de-CH-scout.json",
    "sort-frontend-en": "node deepl.js ../frontend/src/locales/en.json ../frontend/src/locales/en.json",
    "sort-frontend-en-ch-scout": "node deepl.js ../frontend/src/locales/en-CH-scout.json ../frontend/src/locales/en-CH-scout.json",
    "sort-frontend-fr": "node deepl.js ../frontend/src/locales/fr.json ../frontend/src/locales/fr.json",
    "sort-frontend-fr-ch-scout": "node deepl.js ../frontend/src/locales/fr-CH-scout.json ../frontend/src/locales/fr-CH-scout.json",
    "sort-frontend-it": "node deepl.js ../frontend/src/locales/it.json ../frontend/src/locales/it.json",
    "sort-frontend-it-ch-scout": "node deepl.js ../frontend/src/locales/it-CH-scout.json ../frontend/src/locales/it-CH-scout.json",
    "sort-frontend": "npm run sort-frontend-de && npm run sort-frontend-de-ch-scout && npm run sort-frontend-en && npm run sort-frontend-en-ch-scout && npm run sort-frontend-fr && npm run sort-frontend-fr-ch-scout && npm run sort-frontend-it && npm run sort-frontend-it-ch-scout",
    "sort": "npm run sort-frontend",
    "translate-frontend-en-de": "node deepl.js ../frontend/src/locales/en.json ../frontend/src/locales/de.json",
    "translate-frontend-en-de-ch-scout": "node deepl.js ../frontend/src/locales/en-CH-scout.json ../frontend/src/locales/de-CH-scout.json",
    "translate-frontend-en-fr": "node deepl.js ../frontend/src/locales/en.json ../frontend/src/locales/fr.json",
    "translate-frontend-en-fr-ch-scout": "node deepl.js ../frontend/src/locales/en-CH-scout.json ../frontend/src/locales/fr-CH-scout.json",
    "translate-frontend-en-it": "node deepl.js ../frontend/src/locales/en.json ../frontend/src/locales/it.json",
    "translate-frontend-en-it-ch-scout": "node deepl.js ../frontend/src/locales/en-CH-scout.json ../frontend/src/locales/it-CH-scout.json",
    "translate-frontend-en": "npm run translate-frontend-en-de && npm run translate-frontend-en-de-ch-scout && npm run translate-frontend-en-fr && npm run translate-frontend-en-fr-ch-scout && npm run translate-frontend-en-it && npm run translate-frontend-en-it-ch-scout",
    "translate-en": "npm run translate-frontend-en"
  }
}
